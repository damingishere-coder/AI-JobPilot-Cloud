# AI-JobPilot-Cloud 云端基础设施环境变量示例
#
# 1. 本文件只保存非敏感默认值；真实密码由 start_docker 脚本生成到 .secrets/。
# 2. .env、.secrets/、证书、备份、数据库和上传文件都禁止提交。
# 3. 默认只在本机 127.0.0.1:8080 暴露 Nginx，数据库和 Redis 不映射宿主机端口。

# 统一入口
APP_HTTP_PORT=8080
NGINX_SERVER_NAME=localhost
NGINX_CLIENT_MAX_BODY_SIZE=11m
NGINX_PROXY_READ_TIMEOUT=60s
NGINX_AUTH_RATE=10r/m
NGINX_PLUGIN_RATE=120r/m
# 会话 Cookie Secure 标记：本地 HTTP 开发为 false；公网/私有部署必须前置 HTTPS 并设为 true。
AUTH_COOKIE_SECURE=false
AUTH_TERMS_VERSION=2026-08-draft

# 容器与时区
APP_IMAGE_TAG=local
TZ=Asia/Shanghai
JAVA_OPTS=-XX:MaxRAMPercentage=75 -Dfile.encoding=UTF-8

# PostgreSQL：迁移用户名和库名不是秘密；运行时角色固定为 jobpilot_app。
# 密码必须保持为空，由 .secrets/ 注入。
POSTGRES_DB=ai_jobpilot
DB_MIGRATION_USERNAME=jobpilot_owner
DB_MIGRATION_PASSWORD=
DB_APP_PASSWORD=
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# Redis
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_DATABASE=0

# 用户系统：真实 HMAC Pepper 由 .secrets/auth_hash_pepper 注入，此处必须留空。
AUTH_HASH_PEPPER=

# 简历文件和提取文本的 AES-256-GCM Key 由 .secrets/data_encryption_key 注入。
APP_DATA_ENCRYPTION_KEY=
APP_DATA_ENCRYPTION_KEY_ID=v1

# ClamAV 只在 Docker 内部网络开放，不要映射到公网。
CLAMAV_ENABLED=true

# 私有文件存储。默认使用 Docker 私有卷，不由 Nginx 暴露。
APP_STORAGE_TYPE=local
APP_STORAGE_LOCAL_ROOT=/var/lib/ai-jobpilot/private
# 切换为 S3 时填写以下非敏感连接信息，凭证使用部署平台 Secret 或 AWS 标准环境变量。
S3_BUCKET=
S3_REGION=ap-east-1
S3_ENDPOINT=
S3_PATH_STYLE_ACCESS=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AI 岗位匹配分析 Key，由 .secrets/ai_api_key 注入，此处必须留空。
# 不配置时 Worker 启动但会在首次匹配时返回 AI_NOT_CONFIGURED 错误。
AI_API_KEY=
# AI 服务地址和模型是非敏感运行参数；Worker 通过 application-worker.yaml 消费。
# 保持默认值即可，生产环境应在实际供应商/模型验证后再覆盖。
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini

# 旧本地版兼容占位；Cloud Boot Jar 不读取这些变量，必须保持为空，
# 不要把它们误当成云端 Worker 的 Secret 注入方式。
OPENAI_API_KEY=
HUAWEI_API_KEY=
API_KEY=

# 插件绑定与投递执行（均为非敏感运行参数，默认值见 application-api.yaml）。
# 插件 Token 与一次性绑定码由服务端 CSPRNG 生成，不通过环境变量注入。
# PLUGIN_TOKEN_TTL 是有效期（默认 90d），不是密钥；此处留空即使用默认值。
PLUGIN_BIND_CODE_TTL=5m
PLUGIN_MAX_ACTIVE_BIND_CODES=3
PLUGIN_TOKEN_TTL=
PLUGIN_MAX_DEVICES_PER_USER=10
PLUGIN_MIN_EXTENSION_VERSION=
DELIVERY_LEASE_SECONDS=600
DELIVERY_MAX_ATTEMPTS=3

# 保护性限流（AI 匹配与简历上传，按登录 userId 维度；默认值见 application-api.yaml）
RATE_LIMIT_MATCH_ANALYZE_LIMIT=30
RATE_LIMIT_MATCH_ANALYZE_WINDOW=1m
RATE_LIMIT_MATCH_BATCH_LIMIT=10
RATE_LIMIT_MATCH_BATCH_WINDOW=1m
RATE_LIMIT_RESUME_UPLOAD_LIMIT=10
RATE_LIMIT_RESUME_UPLOAD_WINDOW=1m

# 插件待办轮询限流（按认证后的 deviceId 维度，非原始 Token；默认 60 次/分钟）
RATE_LIMIT_PLUGIN_TASK_POLL_LIMIT=60
RATE_LIMIT_PLUGIN_TASK_POLL_WINDOW=1m

# 岗位采集上传端点（/api/plugin/jobs/capture、/batch-capture）已实现；
# 按认证后的 deviceId 维度限流并审计采集上传，绝不使用原始 Token 作为 key。
RATE_LIMIT_PLUGIN_JOB_CAPTURE_LIMIT=30
RATE_LIMIT_PLUGIN_JOB_CAPTURE_WINDOW=1m

# 精确扩展 Origin 白名单（公开信息，非秘密）：对应 chrome-extension/manifest.json
# 固定公钥派生的开发扩展 ID；生产环境改为发布扩展 ID。只接受精确 origin。
PLUGIN_ALLOWED_EXTENSION_ORIGINS=chrome-extension://ompipmnadogogfbebnmjgbbcadildpbc

# 本地桌面应用的 CORS 精确来源白名单（公开信息，非秘密）。
# Web 前端默认仅本机 6866 端口；部署环境必须显式配置，禁止通配符或模式。
APP_ALLOWED_ORIGINS=http://localhost:6866,http://127.0.0.1:6866
APP_ALLOWED_EXTENSION_ORIGINS=chrome-extension://ompipmnadogogfbebnmjgbbcadildpbc

# APP_PUBLIC_URL 当前没有代码消费者，不要添加未使用的伪配置；公网 URL
# 由宿主机 Nginx 的真实域名/Host 和 HTTPS 配置提供。生产部署详见 P10 文档。

# DevPlan canonical 名称映射（仅供验收对照；不要据此新增未被代码消费的 active 变量）：
# DATABASE_URL -> Compose 生成的 SPRING_DATASOURCE_URL；DATABASE_USERNAME -> 固定运行角色 jobpilot_app；
# DATABASE_PASSWORD -> db_app_password Secret（本地兼容入口 DB_APP_PASSWORD 必须为空）。
# REDIS_URL -> REDIS_HOST=redis + REDIS_PORT=6379 + redis_password Secret（兼容入口 REDIS_PASSWORD 必须为空）。
# JWT_SECRET -> 不适用：本项目使用 Redis Session/AJP_SESSION，不使用 JWT。
# APP_ALLOWED_ORIGINS -> 现有 APP_ALLOWED_ORIGINS（仅本地桌面进程使用；云端同源 Web 不加载该 CORS 配置）。
# APP_PUBLIC_URL -> 当前没有代码消费者；公网地址由宿主机 Nginx 的 server_name/Host/HTTPS 提供。
# AI_API_KEY -> 现有 AI_API_KEY 空占位；生产实际从 ai_api_key Secret 注入 Worker。
# AI_BASE_URL -> 现有 AI_BASE_URL；AI_MODEL -> 现有 AI_MODEL（均为 Worker 消费的非敏感运行参数）。
# UPLOAD_DIR -> APP_STORAGE_LOCAL_ROOT（默认 /var/lib/ai-jobpilot/private 私有卷）。
# LOG_DIR -> 生产 stdout/stderr + Docker 日志轮转；本地旧版 APP_LOG_DIR 不作为云端日志目录。
# PLUGIN_TOKEN_SECRET -> 不适用：插件 Token 使用高熵随机值并仅存 SHA-256，不需要环境变量 Secret。
# RATE_LIMIT -> 现有限流键：RATE_LIMIT_* 与 NGINX_AUTH_RATE/NGINX_PLUGIN_RATE，按 userId/deviceId/IP 维度消费。
# ADMIN -> 数据库 ACTIVE ADMIN 角色，由人工受控提权；不提供管理员环境变量自动提权。
