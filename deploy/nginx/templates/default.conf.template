# The host-side Nginx supplies one client IP. Accept only a single IPv4 or
# IPv6-shaped value with strict characters/length; invalid or missing values
# safely fall back to this ingress' immediate client address.
map $http_x_forwarded_for $cloud_client_ip {
    default $remote_addr;
    "~^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$" $http_x_forwarded_for;
    "~^(?=[0-9A-Fa-f:]{2,39}$)(?=[0-9A-Fa-f]*:)[0-9A-Fa-f:]+$" $http_x_forwarded_for;
}

# The Compose ingress normally receives plain HTTP from the host-side Nginx.
# Preserve only an exact outer http/https protocol; invalid or missing values
# safely fall back to the protocol seen by this ingress.
map $http_x_forwarded_proto $cloud_forwarded_proto {
    default $scheme;
    ~^http$ http;
    ~^https$ https;
}

limit_req_zone $cloud_client_ip zone=auth_limit:10m rate=${NGINX_AUTH_RATE};
limit_req_zone $cloud_client_ip zone=plugin_limit:10m rate=${NGINX_PLUGIN_RATE};

log_format cloud_json escape=json
  '{"time":"$time_iso8601","request_id":"$request_id","method":"$request_method",'
  '"path":"$uri","status":$status,'
  '"bytes":$body_bytes_sent,"request_time":$request_time}';

server {
    listen 8080;
    server_name ${NGINX_SERVER_NAME};
    server_tokens off;

    access_log /dev/stdout cloud_json;
    error_log /dev/stderr crit;

    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};
    limit_req_status 429;
    limit_req_log_level notice;

    add_header X-Request-ID $request_id always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'" always;

    # The repository still contains local-edition source for migration history,
    # but Cloud ingress must never expose its pages or credential/Cookie APIs.
    location ~ ^/(?:51job|boss|zhilian|liepin|ai-config|env-config)(?:/|$) { return 404; }
    location ~ ^/api/(?:51job|boss|zhilian|liepin|cookie|ai/(?:config|resume))(?:/|$) { return 404; }

    location = /nginx-health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"UP","service":"nginx"}';
    }

    location = /livez {
        proxy_pass http://api:8888/livez;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_set_header X-Request-ID $request_id;
    }

    location = /readyz {
        proxy_pass http://api:8888/readyz;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_set_header X-Request-ID $request_id;
    }

    location = /api/health {
        proxy_pass http://api:8888/readyz;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_set_header X-Request-ID $request_id;
    }

    location ^~ /actuator/ {
        return 404;
    }

    location = /api/auth/login {
        limit_req zone=auth_limit burst=5 nodelay;
        error_page 429 = @auth_rate_limited;
        proxy_pass http://api:8888;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout ${NGINX_PROXY_READ_TIMEOUT};
    }

    location = /api/auth/register {
        limit_req zone=auth_limit burst=5 nodelay;
        error_page 429 = @auth_rate_limited;
        proxy_pass http://api:8888;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout ${NGINX_PROXY_READ_TIMEOUT};
    }

    location @auth_rate_limited {
        default_type application/json;
        add_header Retry-After 60 always;
        return 429 '{"success":false,"error":{"code":"RATE_LIMITED","message":"请求过于频繁，请稍后再试","fieldErrors":[],"retryable":true},"requestId":"$request_id"}';
    }

    location ^~ /api/plugin/ {
        limit_req zone=plugin_limit burst=30 nodelay;
        proxy_pass http://api:8888;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout ${NGINX_PROXY_READ_TIMEOUT};
    }

    location /api/ {
        proxy_pass http://api:8888;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout ${NGINX_PROXY_READ_TIMEOUT};
    }

    location / {
        proxy_pass http://web:6866;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout ${NGINX_PROXY_READ_TIMEOUT};
    }
}
