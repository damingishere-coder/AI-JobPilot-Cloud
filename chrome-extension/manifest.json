{
  "manifest_version": 3,
  "name": "投递牛马 Cloud Bridge",
  "version": "1.6.0",
  "description": "AI-JobPilot-Cloud 浏览器执行器：绑定云端设备、执行用户确认后的投递任务。",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": [
    "https://toudiniuma.cn/*",
    "https://www.zhipin.com/*",
    "https://*.zhipin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://toudiniuma.cn/*"
      ],
      "js": ["page-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.zhipin.com/*", "https://*.zhipin.com/*"],
      "js": [
        "boss-selectors.js",
        "boss-debug.js",
        "boss-scan-support.js",
        "boss-api-collector.js",
        "boss-search-collector.js",
        "boss-detail-collector.js",
        "boss-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
